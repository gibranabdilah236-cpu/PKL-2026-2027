
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Verifikasi dan Serah Terima</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td, th {
            border: 1px solid #000;
            padding: 10px;
            text-align: left;
        }

        .ttd {
            height: 110px;
            text-align: center;
        }

        .ttd img {
            width: 150px;
            height: 80px;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <h2>VERIFIKASI DAN SERAH TERIMA</h2>

    <table>
        <tr>
            <th>Orang Pertama</th>
            <th>Orang Kedua</th>
        </tr>
        <tr>
            <td>
                Nama: {{ $tertanda->nama_pertama }}<br><br>
                Tanggal: {{ $tertanda->tanggal }}<br><br>
                Paraf:
                <div class="ttd">
                    <img src="{{ $tertanda->ttd_pertama }}">
                </div>
            </td>
            <td>
                Nama: {{ $tertanda->nama_kedua }}<br><br>
                Jam: {{ $tertanda->jam }}<br><br>
                Paraf:
                <div class="ttd">
                    <img src="{{ $tertanda->ttd_kedua }}">
                </div>
            </td>
        </tr>
    </table>
</body>
</html>
